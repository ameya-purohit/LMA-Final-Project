# Copy to .env and fill in. Never commit .env; never paste keys into chat or logs.
# Google AI Studio (aistudio.google.com/apikey). Used by every system.
GEMINI_API_KEY=
# Groq (console.groq.com -> API Keys). Used by the judge.
GROQ_API_KEY=
# Optional: Mistral (console.mistral.ai, free "Experiment" plan). Only if Mistral is the final judge.
MISTRAL_API_KEY=
# GitHub personal access token with public read access only. Used for mining issues.
GITHUB_TOKEN=
